# Optional — mirrors track-web's Caddyfile.local. Only useful for reaching a
# client dev server from another device on the LAN (e.g. testing on a tablet);
# `npm run dev:*` on localhost don't need this at all.
#
# Replace the hostnames below with whatever LAN hostnames you've set up for this
# dev machine, or skip Caddy locally and hit
# http://<this-machine's-LAN-IP>:<dev-port> directly.
#
# Formatting: tabs not spaces. Run `caddy fmt --overwrite Caddyfile.local` after edits.

deck-local.test:80 {
	reverse_proxy localhost:5175
}

introspect-local.test:80 {
	reverse_proxy localhost:5176
}

dungeon-local.test:80 {
	reverse_proxy localhost:5177
}

# Copy to introspect-harness-server/.env (dotenv loads .env from cwd, and
# this server always runs with introspect-harness-server as cwd — see
# src/env.ts). Each harness owns its own .env/PM2 entry per pi-harness.md's
# independent-deploy guidance, so this lives here rather than at the repo root.

# bcrypt hash of the single owner password. Generate with:
#   npm run hash-password -w introspect-harness-server -- 'your-password'
HARNESS_PASSWORD_HASH=

# Secret used to sign the session cookie (Hono's setSignedCookie/getSignedCookie).
# Any long random string; e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# HTTP port for the Hono server (also serves the built client-introspect SPA in prod).
PORT=4200

# cwd for the pi AgentSession: sandbox root for its bash/write/edit/read tools
# and where .pi/skills + AGENTS.md are discovered from. Deliberately outside
# this repo tree (see CLAUDE.md's "Agent sandboxing" section) — defaults to
# ~/.local/share/introspect-harness/workspace if unset.
# INTROSPECT_WORKSPACE_DIR=

# Scratch dir the harness itself (not the agent) uses for temp files.
# Defaults to <os tmpdir>/introspect-harness/tmp if unset.
# INTROSPECT_TMP_DIR=

# Where recorded sessions are stored for replay. Defaults to
# introspect-harness-server/data/recordings (gitignored) if unset.
# RECORDINGS_DIR=

# Set to "true" once the harness sits behind Caddy TLS, so the session cookie
# is marked Secure. Leave unset for plain-HTTP local/LAN use.
# COOKIE_SECURE=true

# Model auth (Anthropic key, OAuth, etc.) is resolved by pi's own ModelRuntime
# from ~/.pi/agent/auth.json / env vars — see `pi login`. Nothing harness-specific
# is needed here unless you want a runtime override; see src/env.ts.

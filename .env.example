# Copy to .env and fill in. Loaded via dotenv/config in deck-harness-server/src/env.ts.

# bcrypt hash of the single owner password. Generate with:
#   npm run hash-password -w deck-harness-server -- 'your-password'
HARNESS_PASSWORD_HASH=

# HTTP port for the Hono server (also serves the built client-deck SPA in prod).
PORT=4100

# cwd for the pi AgentSession: sandbox root for its bash/write/edit tools and
# where .pi/skills + AGENTS.md are discovered from. Defaults to
# deck-harness-server/data/workspace (gitignored, seeded from
# deck-harness-server/templates/agent-workspace on first run) if unset.
# DECK_WORKSPACE_DIR=

# Set to "true" once the harness sits behind Caddy TLS (production/NUC), so the
# session cookie is marked Secure. Leave unset for plain-HTTP local dev.
# COOKIE_SECURE=true

# Model auth (Anthropic key, OAuth, etc.) is resolved by pi's own ModelRuntime
# from ~/.pi/agent/auth.json / env vars — see `pi login`. Nothing harness-specific
# is needed here unless you want a runtime override; see deck-harness-server/src/env.ts.

# Copy to dungeon-harness-server/.env (dotenv loads .env from cwd, and this
# server always runs with dungeon-harness-server as cwd — see src/env.ts).
# Each harness owns its own .env/PM2 entry per pi-harness.md's
# independent-deploy guidance, so this lives here rather than at the repo root.

# bcrypt hash of the single owner password. Generate with:
#   npm run hash-password -w dungeon-harness-server -- 'your-password'
HARNESS_PASSWORD_HASH=

# HTTP port for the Hono server (also serves the built client-dungeon SPA in prod).
PORT=4300

# cwd for the pi AgentSession: sandbox root for its bash/write/edit tools and
# where .pi/skills + AGENTS.md are discovered from. Defaults to
# dungeon-harness-server/data/workspace (gitignored, seeded from
# templates/agent-workspace on first run) if unset.
# DUNGEON_WORKSPACE_DIR=

# Read-only path to track-web's canonical Gherkin corpus:
# client-games/src/games/dungeon-tactics-solo/features/ — dungeon_load_baseline
# reads <this>/<unit>.feature and dungeon_read_step_catalog reads
# <this>/steps-catalog.json. Fine to leave unset, or to point at a directory
# that doesn't exist yet: an absent dir/file is the expected round-one state
# until track-web's phase-02/04 work lands there, and both tools return an
# empty result rather than erroring.
# DUNGEON_TRACKWEB_FEATURES_DIR=

# Set to "true" once the harness sits behind Caddy TLS, so the session cookie
# is marked Secure. Leave unset for plain-HTTP local/LAN use.
# COOKIE_SECURE=true

# Model auth (Anthropic key, OAuth, etc.) is resolved by pi's own ModelRuntime
# from ~/.pi/agent/auth.json / env vars — see `pi login`. Nothing harness-specific
# is needed here unless you want a runtime override; see src/env.ts.
